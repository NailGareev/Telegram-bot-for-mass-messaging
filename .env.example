# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID главного администратора (можно несколько через запятую).
# Свой ID можно узнать, например, у бота @userinfobot
MAIN_ADMIN_IDS=

# Ключ Groq (ИИ для дизайна билета и массового залива) задаётся в приложении Mini App:
# раздел «Настройки», виден только главному администратору.
# Значение ниже — запасной вариант, если в приложении оно не задано.
# GROQ_API_KEY=

# Mini App (приложение внутри Telegram) включается само: бот поднимает веб-сервер
# и бесплатный туннель Cloudflare. Настройки ниже нужны только в особых случаях.
# MINI_APP=off                         # выключить приложение
# TUNNEL=off                           # не запускать туннель автоматически
# WEBAPP_URL=https://tickets.example.com   # свой HTTPS-адрес, ведущий на порт бота
# WEBAPP_PORT=8080

# Необязательно:
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile   # модель Groq для разбора списков (массовый залив)
# LOG_LEVEL=INFO   # подробный журнал в консоль (по умолчанию — только ошибки)
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# TIMEZONE=Asia/Almaty
# TICKET_PREFIX=MV
# DATA_DIR=./data
