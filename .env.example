# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID главного администратора (можно несколько через запятую).
# Свой ID можно узнать, написав боту /id
MAIN_ADMIN_IDS=

# Бесплатный ключ Groq: https://console.groq.com/keys
# Нужен только для смены дизайна билета (ИИ ищет место под QR)
GROQ_API_KEY=

# Необязательно:
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# TIMEZONE=Asia/Almaty
# TICKET_PREFIX=MV
# DATA_DIR=./data
